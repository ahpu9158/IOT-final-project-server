# Copy to .env and change every value. Never commit .env.
# Token the Raspberry Pi sends as ?token=... (give the same value to the gateway team)
DEVICE_TOKEN=change-me
# InfluxDB admin login and API token (any long random strings)
INFLUX_PASS=change-me-too
INFLUX_TOKEN=change-me-influx-token
# Port the web app listens on
PORT=8000
